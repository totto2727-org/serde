import {
  "moonbitlang/core/json",
  "totto2727/model/garde",
  "totto2727/model/serde",
}

import {
  "moonbit-community/serde.mbt" @community_serde,
  "moonbit-community/serde.mbt/json" @community_json,
  "moonbitlang/core/bench",
  "moonbitstack/moonmodel",
  "moonbitstack/moonmodel/verify",
  "totto2727/model-bench/community",
  "totto2727/lens",
} for "wbtest"

rule(name: "model_gen", command: "model_gen $input --output $output")

dev_build(rule: "model_gen", input: "model.mbt", output: "serde.generated.mbt")

dev_build(
  rule: "model_gen",
  input: "validation_model.mbt",
  output: "validation_model.generated.mbt",
)
