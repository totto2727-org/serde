///|
pub const GENERATED_HEADER = "// Generated by totto2727/model (Garde). Do not edit."

///|
pub suberror GenerateError {
  GenerateError(String)
}

///|
priv enum Rule {
  Length(Int32?, Int32?)
  Range(RangeBound?, RangeBound?)
  Required
  Dive
  DiveWith
  DiveUsing(String)
  Inner(Array[Rule])
  Custom(String)
  CustomWith(String)
  Text(String, String?)
  Matches(String)
  PatternWith(String)
  When(String, Bool, Array[Rule])
}

///|
priv struct Emitter {
  prefix : String
  context : String?
  bounds : Map[String, Array[String]]
  explicit_bounds : Map[String, Array[String]]
}

///|
fn fail(at : String, message : String) -> Unit raise GenerateError {
  raise GenerateError("\{at}: \{message}")
}

///|
fn options(
  attrs : @list.List[@attribute.Attribute],
) -> (String, @list.List[@attribute.Prop])? raise GenerateError {
  let mut result = None
  for attr in attrs {
    let at = Show::to_string(attr.loc)
    let props = match attr.parsed {
      Some(Ident({ qual: Some("model"), name: "garde", })) => @list.List([])
      Some(Apply({ qual: Some("model"), name: "garde", }, props)) => props
      None if attr.raw.strip_prefix("#model.garde") is Some(suffix) &&
        suffix.trim_start().has_prefix("(") =>
        raise GenerateError("\{at}: malformed #model.garde attribute")
      _ => continue
    }
    if result is Some(_) {
      fail(at, "repeated #model.garde attribute")
    }
    result = Some((at, props))
  }
  result
}

///|
fn length_bounds(
  props : @list.List[@attribute.Prop],
  at : String,
) -> (Int32?, Int32?) raise GenerateError {
  let kind = "length"
  let mut min = None
  let mut max = None
  let mut equal = None
  for prop in props {
    guard prop is Labeled(key, String(raw)) else {
      raise GenerateError(
        "\{at}: \{kind} expects quoted integer bounds (min, max, or equal)",
      )
    }
    let value = @string.parse_int(raw[:], radix=10) catch {
      _ => raise GenerateError("\{at}: \{key} must be a decimal Int")
    }
    if value < 0 {
      fail(at, "length bounds must be non-negative")
    }
    match key {
      "min" if min is None => min = Some(value)
      "max" if max is None => max = Some(value)
      "equal" if equal is None => equal = Some(value)
      _ => fail(at, "unknown or repeated \{kind} bound: \{key}")
    }
  }
  match (min, max, equal) {
    (None, None, Some(value)) => (Some(value), Some(value))
    (_, _, Some(_)) =>
      raise GenerateError("\{at}: equal cannot be combined with min or max")
    (None, None, None) => raise GenerateError("\{at}: \{kind} requires a bound")
    (Some(a), Some(b), None) if a > b =>
      raise GenerateError("\{at}: min cannot exceed max")
    _ => (min, max)
  }
}

///|
fn function_name(id : @attribute.Id) -> String {
  match id.qual {
    Some(pkg) => "@\{pkg}.\{id.name}"
    None => id.name
  }
}

///|
priv enum RangeBound {
  Literal(String)
  Reference(@attribute.Id)
}

///|
fn range_literal(
  raw : String,
  at : String,
  key : String,
) -> String raise GenerateError {
  let { tokens, errors, .. } = @lexer.tokens_from_string(raw[:], comment=true)
  let invalid = GenerateError(
    "\{at}: \{key} must be a quoted MoonBit numeric literal or a constant",
  )
  guard errors.is_empty() else { raise invalid }
  let (sign, token) = match tokens {
    [(token, _, _), (EOF, _, _)] => ("", token)
    [(MINUS, _, _), (token, _, _), (EOF, _, _)] => ("-", token)
    _ => raise invalid
  }
  let constant = match token {
    INT(text) => @syntax.make_int(text)
    FLOAT(text) => @syntax.make_float(text)
    DOUBLE(text) => Double(text)
    _ => raise invalid
  }
  match constant {
    Int(text)
    | Int64(text)
    | UInt(text)
    | UInt64(text)
    | BigInt(text)
    | Double(text)
    | Float(text) => sign + text
    _ => raise invalid
  }
}

///|
fn range_bounds(
  props : @list.List[@attribute.Prop],
  at : String,
) -> (RangeBound?, RangeBound?) raise GenerateError {
  let bounds = Map([])
  for prop in props {
    guard prop is Labeled("min" | "max" | "equal" as key, expr) else {
      raise GenerateError("\{at}: range expects min, max, or equal")
    }
    if bounds.contains(key) {
      fail(at, "repeated range bound: \{key}")
    }
    let bound : RangeBound = match expr {
      Ident(id) => Reference(id)
      String(raw) => Literal(range_literal(raw, at, key))
      _ =>
        raise GenerateError(
          "\{at}: \{key} must be a quoted MoonBit numeric literal or a constant",
        )
    }
    bounds[key] = bound
  }
  let min = bounds.get("min")
  let max = bounds.get("max")
  match bounds.get("equal") {
    Some(value) if min is None && max is None => (Some(value), Some(value))
    Some(_) =>
      raise GenerateError("\{at}: equal cannot be combined with min or max")
    None => {
      if bounds.is_empty() {
        fail(at, "range requires a bound")
      }
      (min, max)
    }
  }
}

///|
fn parse_rules(
  props : @list.List[@attribute.Prop],
  at : String,
) -> Array[Rule] raise GenerateError {
  let rules = []
  for prop in props {
    let rule : Rule = match prop {
      Expr(Ident({ qual: None, name: "required", })) => Required
      Expr(Ident({ qual: None, name: "dive", })) => Dive
      Expr(Ident({ qual: None, name: "dive_with", })) => DiveWith
      Expr(
        Apply(
          { qual: None, name: "dive_with", },
          More(Expr(Ident({ qual: None, name, })), tail=Empty),
        ),
      ) => DiveUsing(name)
      Expr(Apply({ qual: None, name: "length", }, bounds)) => {
        let (min, max) = length_bounds(bounds, at)
        Length(min, max)
      }
      Expr(Apply({ qual: None, name: "range", }, bounds)) => {
        let (min, max) = range_bounds(bounds, at)
        Range(min, max)
      }
      Expr(Apply({ qual: None, name: "inner", }, inner)) =>
        Inner(parse_rules(inner, at))
      Expr(
        Ident(
          {
            qual: None,
            name: "ascii"
            | "alphanumeric"
            | "email"
            | "url"
            | "ip"
            | "ipv4"
            | "ipv6"
            | "phone_number" as name,
          },
        ),
      ) => Text(name, None)
      Expr(
        Apply(
          {
            qual: None,
            name: "contains"
            | "prefix"
            | "suffix"
            | "pattern" as name,
          },
          More(Expr(String(raw)), tail=Empty),
        ),
      ) => {
        let json = @json.parse("\"\{raw}\""[:]) catch {
          _ =>
            raise GenerateError(
              "\{at}: \{name} expects a JSON-compatible string literal",
            )
        }
        guard json is String(value) else {
          raise GenerateError("\{at}: \{name} expects a string literal")
        }
        if name == "pattern" {
          ignore(@string.Regex(value[:])) catch {
            _ => fail(at, "invalid regular expression in pattern")
          }
        }
        Text(name, Some("\"\{value.escape(quote=false)}\""))
      }
      Expr(
        Apply(
          { qual: None, name: "pattern", },
          More(Expr(Ident(id)), tail=Empty),
        ),
      ) => PatternWith(function_name(id))
      Expr(Apply({ qual: None, name: "pattern", }, _)) =>
        fail_rule(
          at, "pattern expects one quoted regular expression or matcher function",
        )
      Expr(
        Apply(
          { qual: None, name: "when" | "when_with" as kind, },
          More(Expr(Ident(id)), tail=body),
        ),
      ) => When(function_name(id), kind == "when_with", parse_rules(body, at))
      Expr(
        Apply(
          { qual: None, name: "matches", },
          More(Expr(Ident({ qual: None, name, })), tail=Empty),
        ),
      ) => Matches(name)
      Expr(Apply({ qual: None, name: "matches", }, _)) =>
        fail_rule(at, "matches expects one unqualified record field name")
      Expr(
        Apply(
          { qual: None, name: "custom" | "custom_with" as kind, },
          More(Expr(Ident(id)), tail=Empty),
        ),
      ) =>
        if kind == "custom" {
          Custom(function_name(id))
        } else {
          CustomWith(function_name(id))
        }
      _ => fail_rule(at, "unknown or invalid garde rule")
    }
    rules.push(rule)
  }
  if rules.is_empty() {
    fail(at, "expected at least one garde rule")
  }
  rules
}

///|
fn fail_rule(at : String, message : String) -> Rule raise GenerateError {
  raise GenerateError("\{at}: \{message}")
}

///|
fn option_value(ty : @syntax.Type) -> @syntax.Type? {
  match ty {
    Option(ty~, ..)
    | Name(
      constr_id={ id: Ident(name="Option"), .. },
      tys=More(ty, tail=Empty),
      ..
    ) => Some(ty)
    _ => None
  }
}

///|
fn bound_expr(value : Int32?) -> String {
  match value {
    None => "None"
    Some(n) => "Some(\{n})"
  }
}

///|
fn range_bound_expr(value : RangeBound?) -> String {
  match value {
    None => "None"
    Some(Literal(code)) => "Some(\{code})"
    Some(Reference(id)) => "Some(\{function_name(id)})"
  }
}

///|
fn require_bound(
  emitter : Emitter,
  ty : @syntax.Type,
  trait_name : String,
  nested~ : Bool = false,
) -> Unit {
  if ty is Name(constr_id~, tys~, ..) {
    if tys.is_empty() &&
      constr_id.id is Ident(name~) &&
      emitter.bounds.get(name) is Some(bounds) {
      if !emitter.explicit_bounds.contains(name) && !bounds.contains(trait_name) {
        bounds.push(trait_name)
      }
    } else if nested {
      for arg in tys {
        require_bound(emitter, arg, trait_name, nested=true)
      }
    }
  } else if nested {
    match ty {
      Option(ty~, ..) => require_bound(emitter, ty, trait_name, nested=true)
      Tuple(tys~, ..) =>
        for arg in tys {
          require_bound(emitter, arg, trait_name, nested=true)
        }
      _ => ()
    }
  }
}

///|
fn emit_rules(
  out : StringBuilder,
  ty : @syntax.Type,
  rules : Array[Rule],
  at : String,
  emitter : Emitter,
  record~ : (String, @list.List[@syntax.FieldDecl])? = None,
  inner~ : Bool = false,
) -> Unit raise GenerateError {
  let p = emitter.prefix
  for rule in rules {
    if rule is Required {
      guard option_value(ty) is Some(_) else {
        raise GenerateError("\{at}: required expects Option")
      }
      out.write_string(
        "if \{p}value is None { \{p}report.add(\{p}path, \"is required\") }\n",
      )
    } else if rule is When(predicate, uses_context, body) {
      if uses_context && emitter.context is None {
        fail(at, "when_with requires context on the type")
      }
      let args = if uses_context { "\{p}self, \{p}context" } else { "\{p}self" }
      out.write_string("if \{predicate}(\{args}) {\n")
      emit_rules(out, ty, body, at, emitter, record~, inner~)
      out.write_string("}\n")
    } else if rule is Matches(other) {
      if inner {
        fail(at, "matches is only supported directly on record fields")
      }
      guard record is Some((field, fields)) else {
        raise GenerateError(
          "\{at}: matches is only supported directly on record fields",
        )
      }
      if field == other {
        fail(at, "matches cannot refer to the annotated field itself")
      }
      let mut found = false
      for sibling in fields {
        if sibling.name.label == other {
          require_bound(emitter, sibling.ty, "Eq", nested=true)
          found = true
          break
        }
      }
      if !found {
        fail(at, "matches refers to unknown record field: \{other}")
      }
      require_bound(emitter, ty, "Eq", nested=true)
      out.write_string(
        "if \{p}value != \{p}self.\{other} { \{p}report.add(\{p}path, \"must match \{other}\") }\n",
      )
    } else {
      emit_rule(out, ty, rule, at, emitter, record~)
    }
  }
}

///|
fn emit_rule(
  out : StringBuilder,
  ty : @syntax.Type,
  rule : Rule,
  at : String,
  emitter : Emitter,
  record~ : (String, @list.List[@syntax.FieldDecl])?,
) -> Unit raise GenerateError {
  let p = emitter.prefix
  if option_value(ty) is Some(inner) {
    out.write_string("if \{p}value is Some(\{p}value) {\n")
    emit_rule(out, inner, rule, at, emitter, record~)
    out.write_string("}\n")
    return
  }
  let call = match rule {
    Length(min, max) => {
      require_bound(emitter, ty, "Length")
      "@garde.length(\{p}value, \{bound_expr(min)}, \{bound_expr(max)})"
    }
    Range(min, max) => {
      // The field supplies the expected type of both bounds to the compiler.
      require_bound(emitter, ty, "Compare")
      require_bound(emitter, ty, "Show")
      "@garde.range(\{p}value, \{range_bound_expr(min)}, \{range_bound_expr(max)})"
    }
    PatternWith(function) => {
      out.write_string(
        "if !\{function}(\{p}value) { \{p}report.add(\{p}path, \"does not match the pattern\") }\n",
      )
      return
    }
    Custom(function) => "\{function}(\{p}value)"
    CustomWith(function) => {
      guard emitter.context is Some(_) else {
        raise GenerateError("\{at}: custom_with requires context on the type")
      }
      "\{function}(\{p}value, \{p}context)"
    }
    Text(rule, arg) =>
      match arg {
        Some(literal) => "@garde.\{rule}(\{p}value, \{literal})"
        None => "@garde.\{rule}(\{p}value)"
      }
    Dive => {
      require_bound(emitter, ty, "Validate", nested=true)
      out.write_string(
        "@garde.Validate::collect(\{p}value, \{p}report, \{p}path)\n",
      )
      return
    }
    DiveWith => {
      guard emitter.context is Some(_) else {
        raise GenerateError("\{at}: dive_with requires context on the type")
      }
      out.write_string(
        "\{p}value.collect_with(\{p}context, \{p}report, \{p}path)\n",
      )
      return
    }
    DiveUsing(other) => {
      guard record is Some((_, fields)) &&
        fields.any(field => field.name.label == other) else {
        raise GenerateError(
          "\{at}: dive_with expects the name of a sibling record field",
        )
      }
      out.write_string(
        "\{p}value.collect_with(\{p}self.\{other}, \{p}report, \{p}path)\n",
      )
      return
    }
    Inner(rules) => {
      guard ty
        is Name(
          constr_id={
            id: Ident(name="Array" | "ReadOnlyArray" | "FixedArray"),
            ..
          },
          tys=More(item, tail=Empty),
          ..
        ) else {
        raise GenerateError(
          "\{at}: inner expects an Array, ReadOnlyArray, or FixedArray",
        )
      }
      out.write_string(
        "for \{p}index, \{p}value in \{p}value {\nlet \{p}path = \{p}path.index(\{p}index)\n",
      )
      emit_rules(out, item, rules, at, emitter, record~, inner=true)
      out.write_string("}\n")
      return
    }
    Required | Matches(_) | When(_, _, _) =>
      abort("rule is emitted before unwrapping Option")
  }
  out.write_string(
    "if \{call} is Some(message) { \{p}report.add(\{p}path, message) }\n",
  )
}

///|
/// Generate validation implementations without changing any JSON codecs.
pub fn generate_many(
  sources : Array[(String, String)],
) -> String raise GenerateError {
  let out = StringBuilder()
  let seen : Map[String, String] = Map([])
  for source in sources {
    let (name, text) = source
    // Do not shadow a custom validator's function name.
    let mut prefix = "garde_"
    while text.contains(prefix) {
      prefix += "_"
    }
    let (items, reports) = @parser.parse_string(text, name~)
    if !reports.is_empty() {
      raise GenerateError(Show::to_string(reports[0]))
    }
    for item in items {
      if item is TopTypeDef(decl) {
        emit_declaration(out, decl, seen, prefix)
      }
    }
  }
  let (impls, reports) = @parser.parse_string(
    out.to_string(),
    name="garde.generated.mbt",
  )
  if !reports.is_empty() {
    raise GenerateError(Show::to_string(reports[0]))
  }
  GENERATED_HEADER + "\n" + @fmt.impls_to_string(impls)
}
